# Copied to /var/www/surfsite/server/.env by 01-setup-vps.sh — EDIT THE PLACEHOLDERS.
NODE_ENV=production
PORT=5000

# MongoDB Atlas — create a NEW db user for production, don't reuse dev credentials.
# Also add the VPS IP to Atlas Network Access (IP allowlist).
MONGO_URI=REPLACE_ME_mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/surf-site?retryWrites=true&w=majority

# Generate a fresh secret on the VPS:  openssl rand -hex 32
JWT_SECRET=REPLACE_ME_run_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Used for CORS — must match the public site URL exactly
CLIENT_URL=https://hiriketiyanoahsurfschool.com
